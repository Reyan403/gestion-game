{% extends 'base.html.twig' %}

{% block title %}Gestion des utilisateurs
{% endblock %}

{% block body %}

	<section class="flex min-h-screen bg-[#181f2e] font-sans">
		{{ include('composants/sidebar.html.twig') }}

		<main class="flex-1 p-8 text-white">

			<div class="flex justify-between items-center mb-10 mt-2">
				<h1 class="text-white text-2xl font-bold">Gestion des utilisateurs</h1>
			</div>

			<div class="bg-[#1f2839] rounded-xl overflow-hidden shadow-xl border border-[#2b3548]">
				<table class="w-full text-left border-collapse">
					<thead>
						<tr class="bg-[#293448] text-[15px] font-bold text-gray-200 border-b border-[#3b475c]">
							<th class="px-6 py-5">Utilisateur</th>
							<th class="px-6 py-5">Email</th>
							<th class="px-6 py-5">Rôle</th>
							<th class="px-6 py-5 text-center">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-[#2b3548] text-[15px]">

						{% for u in users %}
							<tr class="hover:bg-[#252f43] transition-colors">
								<td class="px-6 py-4 whitespace-nowrap">
									<div class="flex items-center gap-4">
										<span class="font-medium text-gray-100">{{ u.getName() }}</span>
									</div>
								</td>

								<td class="px-6 py-4 whitespace-nowrap text-gray-300">
									{{ u.getMail() }}
								</td>

								<td class="px-6 py-4 whitespace-nowrap">
									<div class="flex flex-wrap gap-2">
										{% for ur in u.getRolesEntities %}
											<span class="bg-blue-600 text-white text-xs font-semibold px-3 py-1 rounded-full">
												{{ ur.getName() }}
											</span>
										{% endfor %}
									</div>
								</td>

								<td class="px-6 py-4 whitespace-nowrap">
									<div class="flex items-center justify-center gap-5">
										<a href="{{ path('app_user_management', {editId: u.id}) }}" class="text-[#60a5fa] hover:text-blue-300 transition-colors" title="Modifier">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-[21px] w-[21px]" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
											</svg>
										</a>
										<a href="{{ path('app_user_management', {deleteId: u.id}) }}" class="text-[#f87171] hover:text-red-400 transition-colors" title="Supprimer" onclick="return confirm('Voulez-vous supprimer ce jeu ?')">
											<svg xmlns="http://www.w3.org/2000/svg" class="h-[21px] w-[21px]" fill="none" viewbox="0 0 24 24" stroke="currentColor" stroke-width="2">
												<path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
											</svg>
										</a>
									</div>
								</td>
							</tr>

							{# Si le formulaire de modification existe et que l'id de l'utilisateur correspond à celui dans l'url #}
							{% if editId == u.id and formEdit %}
								<div>
									{% embed 'composants/popup.html.twig' %}

										{% block title %}
											Modifier l'utilisateur 
										{% endblock %}

										{% block content %}
											{% set inputClass = 'w-full bg-[#324059] border border-[#3f506b] rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors shadow-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-500 file:text-white hover:file:bg-blue-600' %}
											{% set labelClass = 'block text-[15px] font-bold text-gray-200 mb-2' %}

											{{ form_start(formEdit, {'attr': {'class': 'flex flex-col gap-5 pt-2'}}) }}

											<div>
												{{ form_label(formEdit.name, null, {'label_attr': {'class': labelClass}}) }}
												{{ form_widget(formEdit.name, {'attr': {'class': inputClass}}) }}
												{{ form_errors(formEdit.name) }}
											</div>

											<div>
												{{ form_label(formEdit.mail, null, {'label_attr': {'class': labelClass}}) }}
												{{ form_widget(formEdit.mail, {'attr': {'class': inputClass}}) }}
												{{ form_errors(formEdit.mail) }}
											</div>

											<div>
												{{ form_label(formEdit.rolesEntities, null, {'label_attr': {'class': labelClass}}) }}
												{% set checkboxContainerClass = 'grid grid-cols-1 sm:grid-cols-2 gap-3 bg-[#252f43] border border-[#3f506b] rounded-xl p-4 max-h-60 overflow-y-auto scrollbar-thin scrollbar-thumb-[#4a5f80] scrollbar-track-transparent [&>div]:flex [&>div]:items-center [&>div]:gap-3 [&>div]:px-4 [&>div]:py-3 [&>div]:bg-[#181f2e] [&>div]:border [&>div]:border-[#3f506b] [&>div]:rounded-lg hover:[&>div]:border-blue-500 hover:[&>div]:bg-[#1c2436] [&>div]:transition-colors [&_input]:w-5 [&_input]:h-5 [&_input]:text-blue-500 [&_input]:bg-[#252f43] [&_input]:border-[#4a5f80] [&_input]:rounded focus:[&_input]:ring-blue-500 focus:[&_input]:ring-2 [&_input]:cursor-pointer [&_label]:text-sm [&_label]:font-medium [&_label]:text-gray-200 [&_label]:cursor-pointer [&_label]:flex-1 [&_label]:mb-0 [&_label]:select-none' %}
												{{ form_widget(formEdit.rolesEntities, {'attr': {'class': checkboxContainerClass}}) }}
												{{ form_errors(formEdit.rolesEntities) }}
											</div>

											<div class="grid grid-cols-2 gap-5 mt-4">
												<button type="submit" class="w-full bg-[#2563eb] hover:bg-blue-600 transition-colors text-white py-3 rounded-lg font-bold text-[15px] shadow-lg shadow-blue-500/20">
													Modifier
												</button>

												<a href="{{ path('app_user_management') }}" id="btn_cancel_edit_game" class="w-full bg-[#3b475c] hover:bg-[#4a586e] transition-colors text-white py-3 rounded-lg font-bold text-[15px] text-center flex items-center justify-center">
													Annuler
												</a>
											</div>

											{{ form_end(formEdit) }}
										{% endblock %}

									{% endembed %}
								</div>
							{% endif %}
						{% endfor %}
					</tbody>
				</table>
			</div>
		</main>

	</section>
{% endblock %}
