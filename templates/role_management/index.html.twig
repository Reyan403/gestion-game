{% extends 'base.html.twig' %}

{% block title %}Gestion des Rôles – GameHub
{% endblock %}

{% block body %}
	<div
		class="flex min-h-screen bg-[#181f2e]">

		{#  Sidebar  #}
		{{ include('composants/sidebar.html.twig') }}

		{#  Contenu principal  #}
		<main
			class="flex-1 p-8">

			{#  En-tête de page  #}
			<div class="flex items-center justify-between mb-8">
				<div class="flex items-center gap-3">
					<svg class="w-6 h-6 text-[#266bfd]" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
					</svg>
					<h1 class="text-white text-2xl font-bold tracking-wide">Gestion des Rôles</h1>
				</div>
				<button id="newRoleButton" class="flex items-center gap-2 bg-[#266bfd] hover:bg-blue-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors shadow-lg">
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
					</svg>
					Créer un rôle
				</button>
			</div>

			{#  Formulaire : nouveau rôle #}
			<div id="newRoleForm" class="hidden bg-[#232a39] border border-slate-700 rounded-2xl p-6 mb-6 shadow-xl">
				<h2 class="text-white font-semibold text-base mb-4">Nouveau rôle</h2>
				{{ form_start(formNew, {action: path('app_role_management', {action: 'new'}), attr: {class: 'flex items-center gap-3'}}) }}
				{{ form_widget(formNew.name, {attr: {
                    class: 'flex-1 bg-[#181f2e] border border-slate-600 text-slate-200 text-sm rounded-xl px-4 py-2.5 focus:outline-none focus:border-[#266bfd] placeholder-slate-500',
                }}) }}
				<button type="submit" class="bg-[#266bfd] hover:bg-blue-600 text-white text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors">
					Créer
				</button>
				<button id="cancelNewRoleButton" class="bg-slate-700 hover:bg-slate-600 text-slate-200 text-sm font-semibold px-5 py-2.5 rounded-xl transition-colors">
					Annuler
				</button>
				{{ form_end(formNew) }}
			</div>

			{#  Liste des rôles  #}
			<div
				class="bg-[#232a39] border border-slate-700 rounded-2xl shadow-xl overflow-hidden">

				{# Titre du bloc #}
				<div class="px-6 py-4 border-b border-slate-700">
					<h2 class="text-slate-200 font-semibold text-base">
						Rôles existants ({{ roles|length }})
					</h2>
				</div>

				{# Lignes #}
				<ul class="divide-y divide-slate-700">
					{% for r in roles %}
						<li
							class="flex items-center gap-4 px-6 py-4 hover:bg-[#1c2335] transition-colors group">

							{# Icône bouclier #}
							<div class="w-8 h-8 flex-shrink-0 flex items-center justify-center rounded-full bg-[#181f2e] border border-slate-600">
								<svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewbox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
								</svg>
							</div>

							{#  mode édition  #}
							{% if editId == r.id and formEdit %}
								{{ form_start(formEdit, {attr: {class: 'flex-1 flex items-center gap-3'}}) }}
								{{ form_widget(formEdit.name, {attr: {
                                class: 'flex-1 bg-[#181f2e] border border-[#266bfd] text-slate-200 text-sm rounded-xl px-4 py-2 focus:outline-none placeholder-slate-500',
                                autofocus: 'autofocus'
                            }}) }}
								<button type="submit" class="text-green-400 hover:text-green-300 bg-green-900/30 hover:bg-green-900/50 px-3 py-1.5 rounded-lg text-sm font-medium transition-colors">
									Valider
								</button>
								<a href="{{ path('app_role_management') }}" class="text-slate-400 hover:text-slate-200 bg-slate-800 hover:bg-slate-700 px-3 py-1.5 rounded-lg text-sm font-medium transition-colors">
									Annuler
								</a>
								{{ form_end(formEdit) }}

							{% else %}
								{# Infos du rôle #}
								<div class="flex-1 min-w-0">
									<p class="text-white font-semibold text-sm truncate">{{ r.name }}</p>
								</div>

								{# Boutons d'action #}
								<div class="flex items-center gap-2 transition-opacity">
									<a href="{{ path('app_role_management', {editId: r.id}) }}" title="Modifier" class="flex items-center gap-1.5 text-slate-400 hover:text-[#266bfd] bg-slate-800 hover:bg-blue-900/30 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">
										<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
										</svg>
										Modifier
									</a>
									<a href="{{ path('app_role_management', {deleteId: r.id}) }}" title="Supprimer" onclick="return confirm('Supprimer le rôle « {{ r.name }} » ?')" class="flex items-center gap-1.5 text-slate-400 hover:text-red-400 bg-slate-800 hover:bg-red-900/30 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors">
										<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
										</svg>
										Supprimer
									</a>
								</div>
							{% endif %}

						</li>
					{% else %}
						<li class="px-6 py-10 text-center text-slate-500 text-sm">
							Aucun rôle trouvé.
						</li>
					{% endfor %}
				</ul>
			</div>

			{#  Bloc information  #}
			<div class="mt-6 flex items-start gap-3 bg-blue-900/20 border border-blue-800/40 rounded-2xl px-6 py-4">
				<svg class="w-5 h-5 text-[#266bfd] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
				</svg>
				<p class="text-slate-400 text-xs leading-relaxed">
					<span class="text-blue-400 font-semibold">Information</span><br>
					Après avoir créé un rôle, configurez ses permissions dans l'onglet
					<span class="text-white font-medium">"Gestion des Droits"</span>.
				</p>
			</div>

		</main>
	</div>
{% endblock %}
