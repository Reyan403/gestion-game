{% extends 'base.html.twig' %}

{% block body %}
	<main class="min-h-screen bg-[#0d1627] text-gray-200 font-sans pt-20 pb-20">
		<div class="max-w-[95%] mx-auto px-4 sm:px-6 lg:px-8">
			<div class="mb-4">
				<a href="{{ path('app_home') }}" class="text-blue-500 hover:text-blue-400 flex items-center text-sm font-medium">
					<svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
					</svg>
					Retour aux jeux
				</a>
			</div>

			<div class="flex flex-col lg:flex-row gap-6">
				<div class="flex-1 space-y-6">
					<div class="rounded-xl overflow-hidden shadow-lg border border-gray-800">
						<img src="{{ asset(game.image) }}" alt="{{ game.title }}" class="w-full max-h-[500px] object-cover">
					</div>

					<div
						class="bg-[#1e293b] rounded-xl p-6 shadow-md border border-gray-800">

						{# Couleur des étoiles : orange si connecté et pas encore voté, jaune sinon #}
						{% if app.user and userRating is null %}
							{% set starColorClass = 'text-orange-400' %}
						{% else %}
							{% set starColorClass = 'text-yellow-400' %}
						{% endif %}
						{% set avg = average|default(0) %}

						<div class="flex items-center gap-5 mb-8 flex-wrap">
							<h1 class="text-4xl font-bold text-white">{{ game.title }}</h1>

							{# Bloc étoiles unifié : affiche la moyenne ET permet de voter #}
							<div class="flex items-center gap-3">
								<div
									id="rating-stars" data-movie-id="{{ game.id }}" data-url="{{ path('app_game', {'id': game.id}) }}" data-is-logged-in="{{ app.user ? 'true' : 'false' }}" data-user-rating="{{ userRating|default('') }}" data-average="{{ avg }}" data-star-color="{{ starColorClass }}" class="flex flex-row-reverse justify-end cursor-pointer select-none">
									{# Les étoiles reflètent la moyenne au chargement #}
									<span data-value="5" class="star text-3xl leading-none transition-colors duration-150 {{ avg >= 5 ? 'text-yellow-400' : starColorClass }}">{{ avg >= 5 ? '★' : '☆' }}</span>
									<span data-value="4" class="star text-3xl leading-none transition-colors duration-150 {{ avg >= 4 ? 'text-yellow-400' : starColorClass }}">{{ avg >= 4 ? '★' : '☆' }}</span>
									<span data-value="3" class="star text-3xl leading-none transition-colors duration-150 {{ avg >= 3 ? 'text-yellow-400' : starColorClass }}">{{ avg >= 3 ? '★' : '☆' }}</span>
									<span data-value="2" class="star text-3xl leading-none transition-colors duration-150 {{ avg >= 2 ? 'text-yellow-400' : starColorClass }}">{{ avg >= 2 ? '★' : '☆' }}</span>
									<span data-value="1" class="star text-3xl leading-none transition-colors duration-150 {{ avg >= 1 ? 'text-yellow-400' : starColorClass }}">{{ avg >= 1 ? '★' : '☆' }}</span>
								</div>

								{# Note moyenne + compteur + label interactif #}
								<div class="flex items-center gap-3">
									<div class="flex flex-col">
										<span class="text-xl font-bold text-yellow-400">
											{{ average ? average|number_format(1, '.', '') : '0.0' }}
											<span class="text-sm font-normal text-gray-500">/5</span>
										</span>
										<span class="text-sm font-normal text-gray-400">
											(
											{{ totalNotes|length }}
											)
										</span>
									</div>

									<span id="rating-label" class="text-sm text-gray-400">
										{# Si l'utilisateur a déjà voté, on affiche sa note et un lien pour la modifier #}
										{# Sinon si l'utilisateur est connecté, on affiche un lien pour noter #}
										{# Sinon on affiche un lien pour se connecter #}
											{% if userRating %}
											Votre note :
											{{ userRating }}
											/5 &mdash; Cliquez pour modifier
										{% elseif app.user %}
											Cliquez pour noter
										{% else %}
											Connectez-vous pour noter
										{% endif %}
									</span>
								</div>
							</div>
						</div>

						<div class="flex flex-wrap gap-3 mb-8">
							{% for category in game.categories %}
								<span class="px-4 py-1.5 bg-blue-600 text-white text-sm font-semibold rounded-full min-w-[80px] text-center">{{ category.name }}</span>
							{% else %}
								<span class="px-4 py-1.5 bg-blue-600 text-white text-sm font-semibold rounded-full min-w-[80px] text-center">Jeu</span>
							{% endfor %}
						</div>

						<p class="text-gray-300 text-base leading-relaxed mb-10">
							{{ game.description }}
						</p>
					</div>
				</div>

				<div class="lg:w-[450px] flex-shrink-0">
					<div class="bg-[#1e293b] rounded-xl p-5 shadow-md border border-gray-800">
						<div class="flex items-center gap-2 mb-4">
							<span class="relative flex h-3 w-3">
								<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
								<span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
							</span>
							<h2 class="text-white font-bold text-xl flex items-center gap-2">
								<svg class="w-6 h-6 text-red-500" fill="currentColor" viewbox="0 0 24 24"><path d="M11.64 5.93h1.43v4.28h-1.43V5.93zm4.28 0h1.43v4.28h-1.43V5.93zM21 2.5H3v15h5v4l4-4h4.5L21 13V2.5zm-2 9.5l-3.5 3.5h-4l-3.5 3.5v-3.5H4.5V4.5h14.5v7.5z"/></svg>
								Streams en direct
							</h2>
						</div>

						<div class="space-y-4">
							{% for stream in streams %}
								<div
									class="flex gap-3 bg-[#0f172a] p-3 rounded-lg border border-gray-800">
									{# Miniature du stream #}
									<div
										class="w-20 h-14 bg-gray-700 rounded overflow-hidden flex-shrink-0 relative">
										{# On remplace les dimensions dans l'URL de Twitch par du 160x90 #}
										<img src="{{ stream.thumbnail_url|replace({'{width}': '160', '{height}': '90'}) }}" alt="{{ stream.user_name }} stream" class="w-full h-full object-cover">
										<div class="absolute top-1 left-1 bg-red-600 text-white text-[10px] font-bold px-1 rounded">EN DIRECT</div>
									</div>

									{# Infos du stream #}
									<div
										class="flex-1 min-w-0">
										{# Nom du streamer avec lien vers sa chaine #}
										<a href="https://twitch.tv/{{ stream.user_login }}" target="_blank" class="text-white text-base font-semibold truncate hover:text-blue-400 block">
											{{ stream.user_name }}
										</a>

										{# Titre du live #}
										<p class="text-gray-400 text-sm truncate mt-0.5" title="{{ stream.title }}">
											{{ stream.title }}
										</p>

										<div
											class="flex justify-between items-center mt-2">
											{# Nom du jeu (ex: Valorant, CS2...) #}
											<span class="text-purple-400 text-sm truncate mr-2">{{ stream.game_name }}</span>

											{# Nombre de viewers avec l'icône #}
											<span class="flex items-center text-gray-400 text-sm gap-1 flex-shrink-0">
												<svg class="w-4 h-4" fill="currentColor" viewbox="0 0 20 20">
													<path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
												</svg>
												{# Formatage du nombre (ex: 15420 -> 15 420) #}
												{{ stream.viewer_count|number_format(0, ',', ' ') }}
											</span>
										</div>
									</div>
								</div>
							{% else %}
								{# Message si aucun live n'est trouvé pour les catégories du jeu #}
								<div class="p-4 text-center text-gray-500 italic border border-dashed border-gray-800 rounded-lg">
									Aucun stream en direct pour ces catégories.
								</div>
							{% endfor %}
						</div>
					</div>
				</div>
			</div>

			<div class="mt-8 bg-[#1e293b] rounded-xl p-8 shadow-md border border-gray-800">

				<div class="mb-10">
					<h2 class="font-bold text-2xl text-white mb-6">Commentaires (
						{{ commentaryList|length }}
						)</h2>


					<h3 class="text-lg font-bold text-white mb-3">Laisser un commentaire</h3>

					<div class="mb-6">
						<label class="block text-base font-semibold text-gray-300 mb-3">Votre commentaire</label>
						{{ form_start(form) }}
						{{ form_widget(form.description, {
                                'attr': {
                                    'class': 'w-full bg-[#2d3748] border border-gray-600 rounded-lg p-4 text-base text-white placeholder-gray-400 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 resize-y min-h-[140px]',
                                    'placeholder': 'Partagez votre expérience avec ce jeu...'
                                }
                            }) }}
						{{ form_errors(form.description) }}

						<div class="mt-6">
							{{ form_widget(form.submit, {
                                    'attr': {
                                        'class': 'bg-blue-600 hover:bg-blue-700 text-white font-semibold text-base py-3 px-8 rounded-lg transition-colors cursor-pointer border-none shadow-sm'
                                    }
                                }) }}
						</div>
						{{ form_end(form) }}
					</div>
				</div>

				<hr class="border-gray-700 my-6">

				<div class="mt-10">
					{% if commentaryList is empty %}
						<p class="text-center text-gray-400 text-base py-6">Aucun avis pour le moment. Soyez le premier à en laisser un !</p>
					{% else %}
						<div class="space-y-6">
							{% for c in commentaryList %}
								<div class="bg-transparent border-t border-gray-800 pt-8 mt-8 first:border-0 first:pt-0 first:mt-0">
									<div class="flex justify-between items-start mb-3">
										<h4 class="font-bold text-white text-base">{{ c.getUser().getName() }}</h4>
										<span class="text-sm text-gray-500">{{ c.getDate()|date('d/m/Y à H:i') }}</span>
									</div>
									<p class="text-gray-300 text-base leading-relaxed">{{ c.getDescription() }}</p>
								</div>
							{% endfor %}
						</div>
					{% endif %}
				</div>

			</div>
		</div>
	</main>
{% endblock %}
