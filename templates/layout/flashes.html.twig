{% for label, messages in app.flashes %}
	{% set styles = {
		'succès': 'bg-[#1a2e1a] border-green-700 text-green-300',
		'erreur': 'bg-[#2e1a1a] border-red-700 text-red-300',
		'warning': 'bg-[#2e2a1a] border-yellow-700 text-yellow-300',
		'info': 'bg-[#1a1f2e] border-blue-700 text-blue-300'
	} %}
	{% set icons = {
		'succès': 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
		'erreur': 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z',
		'warning': 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
		'info': 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
	} %}
	{% for message in messages %}
		{% set style = styles[label] is defined ? styles[label] : 'bg-[#1e2535] border-slate-600 text-slate-300' %}
		{% set icon  = icons[label]  is defined ? icons[label]  : 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' %}

		<div class="toast-flash fixed bottom-6 right-6 z-[9999] flex items-start gap-3 max-w-sm w-full px-4 py-3 rounded-xl border shadow-2xl {{ style }}" style="animation: toastIn 0.35s cubic-bezier(.21,1.02,.73,1) forwards; position: fixed;">

			<svg class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewbox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ icon }}"/>
			</svg>

			<div class="flex-1 text-sm leading-snug">
				<p class="font-semibold capitalize mb-0.5">{{ label }}</p>
				<p class="opacity-80">{{ message }}</p>
			</div>

			<div class="toast-bar absolute bottom-0 left-0 h-0.5 bg-current opacity-40 rounded-b-xl" style="width: 100%; animation: toastBar 5s linear forwards;"></div>
		</div>
	{% endfor %}
{% endfor %}

<style>
	{% verbatim %}
		@keyframes toastIn {
			from {
				opacity: 0;
				transform: translateX(110%);
			}
			to {
				opacity: 1;
				transform: translateX(0);
			}
		}
		@keyframes toastOut {
			from {
				opacity: 1;
				transform: translateX(0);
			}
			to {
				opacity: 0;
				transform: translateX(110%);
			}
		}
		@keyframes toastBar {
			from {
				width: 100%;
			}
			to {
				width: 0;
			}
		}
	{% endverbatim %}
</style>

<script>
	document.querySelectorAll('.toast-flash').forEach(function (el) {
setTimeout(function () {
el.style.animation = 'toastOut 0.35s ease forwards';
setTimeout(function () {
el.remove();
}, 350);
}, 5000);
});
</script>
