<div id="popup-container" class="fixed top-0 left-0 right-0 bottom-0 bg-black/60 backdrop-blur-sm z-50 flex justify-center items-center py-6">
	<div class="bg-[#1e293b] w-full max-w-2xl mx-4 rounded-xl shadow-2xl relative flex flex-col max-h-full">

		<!-- Header -->
		<div class="px-8 pt-6 pb-4 flex justify-between items-center">
			<h2 class="text-2xl font-bold text-white tracking-wide">
				{% block title %}{% endblock %}
			</h2>
		</div>

		<!-- Content -->
		<div class="px-8 pb-8 overflow-y-auto custom-popup-scrollbar flex-1">
			{% block content %}{% endblock %}
		</div>

	</div>
</div>