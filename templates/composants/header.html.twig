{# ═══════════════════ HEADER ═══════════════════ #}
<header class="bg-[#0f1422] border-b border-white/5 p-6">
	<div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
		<a href="{{ path('app_home') }}" class="flex items-center gap-2.5 group">
			<span class="font-bold text-[1.05rem] text-white tracking-wide">GameHub</span>
		</a>
		<div
			class="flex items-center gap-4">
			{# Déjà connecté #}
			{% if app.user %}
				<div class="flex items-center gap-5">
					<a href="{{ path('app_home') }}" class="text-sm text-white/40 hidden sm:block">
						<strong class="text-white/80">{{ app.user.getName() }}</strong>
					</a>

					<div
						class="flex items-center gap-5">
						{# Icône Profil/Paramètres avec tooltip #}
						<div class="relative group/profile flex items-center">
							<a href="{{ path('profil_edit', { id: app.user.id }) }}" class="p-2 rounded-lg hover:bg-white/5 transition-colors">
								<svg class="w-[18px] h-[18px] text-gray-400 group-hover/profile:text-white transition-colors" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
									<circle cx="12" cy="12" r="3"></circle>
								</svg>
							</a>
						</div>

						{# Icône Déconnexion avec tooltip #}
						<div class="relative group/logout flex items-center">
							<a href="{{ path('app_logout') }}" class="p-2 rounded-lg hover:bg-red-500/10 transition-colors">
								<svg class="w-[18px] h-[18px] text-gray-400 group-hover/logout:text-red-400 transition-colors" xmlns="http://www.w3.org/2000/svg" viewbox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
									<polyline points="16 17 21 12 16 7"></polyline>
									<line x1="21" y1="12" x2="9" y2="12"></line>
								</svg>
							</a>
						</div>
					</div>
				</div>
			{% else %}
				<button id="btn-pop" class="sm:block text-gray-300 hover:text-white text-xs font-medium uppercase tracking-wider">Connexion</button>
			{% endif %}
		</div>
	</div>
</header>
