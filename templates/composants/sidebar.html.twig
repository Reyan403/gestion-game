<aside class="w-20 lg:w-64 bg-[#232a39] min-h-screen text-slate-300 flex flex-col pt-6 font-sans flex-shrink-0 transition-all duration-300" style="background-color: #232a39;">
    
    {# En-tête de la sidebar #}
    <div class="px-0 lg:px-6 flex justify-center lg:justify-start mb-8 mt-2">
        <h2 class="hidden lg:block text-white text-lg font-bold tracking-wide">Gestion</h2>
    </div>

    {# Navigation #}
    <nav class="flex-1 px-2 lg:px-4 space-y-2 lg:space-y-1">
        
        {# On récupère la route actuelle #}
        {% set current_route = app.request.attributes.get('_route') %}
        
        {% if app.user %}
            <a href="{{ path('profil_edit', {'id': app.user.id}) }}" 
                class="flex items-center justify-center lg:justify-start gap-3 px-4 py-3 rounded-xl transition-colors mt-1 {{ current_route == 'profil_edit' ? 'bg-[#266bfd] text-white shadow-md' : 'text-slate-400 hover:text-white hover:bg-slate-800' }}" 
                title="Mon Profil">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
                <span class="hidden lg:inline text-sm font-semibold">Mon Profil</span>
            </a>
        {% endif %}

        {% if is_granted('Validation d\'un commentaire') %}
            <a href="{{ path('app_comment_moderation') }}" 
                class="flex items-center justify-center lg:justify-start gap-3 px-4 py-3 rounded-xl transition-colors mt-1 {{ current_route == 'app_comment_moderation' ? 'bg-[#266bfd] text-white shadow-md' : 'text-slate-400 hover:text-white hover:bg-slate-800' }}" 
                title="Modération">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                </svg>
                <div class="hidden lg:flex flex-col">
                    <span class="text-sm font-medium">Modération</span>
                    <span class="text-sm font-medium leading-tight mt-0.5">Commentaires</span>
                </div>
            </a>
        {% endif %}

        {% if is_granted('Validation d\'une fiche de jeu') %}
            <div class="flex flex-col mt-2 mb-1">
                <div class="flex items-center justify-center lg:justify-start gap-3 px-4 py-2 text-slate-400 mb-1" title="Validation">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="hidden lg:inline text-sm font-medium font-bold tracking-wider">Validation des jeux</span>
                </div>

                <a href="{{ path('app_game_validation') }}" 
                    class="flex items-center justify-center lg:justify-start gap-3 lg:pl-12 px-4 py-2.5 rounded-xl transition-colors {{ current_route == 'app_game_validation' ? 'bg-[#266bfd] text-white shadow-md' : 'text-slate-400 hover:text-white hover:bg-slate-800' }}" 
                    title="Nouveaux jeux">
                    <span class="lg:hidden text-xs">•</span>
                    <span class="hidden lg:inline text-sm font-medium">Nouveaux jeux</span>
                </a>

                <a href="{{ path('app_game_update_validation') }}" 
                    class="flex items-center justify-center lg:justify-start gap-3 lg:pl-12 px-4 py-2.5 rounded-xl transition-colors mt-1 {{ current_route == 'app_game_update_validation' ? 'bg-[#266bfd] text-white shadow-md' : 'text-slate-400 hover:text-white hover:bg-slate-800' }}" 
                    title="Jeux actuels">
                    <span class="lg:hidden text-xs">•</span> 
                    <span class="hidden lg:inline text-sm font-medium">Jeux actuels</span>
                </a>
            </div>
        {% endif %}

        {% if is_granted('Attribuer un rôle') or is_granted('Suppression d\'un utilisateur') or is_granted('Voir les rôles') %}
            <a href="{{ path('app_user_management') }}" 
                class="flex items-center justify-center lg:justify-start gap-3 px-4 py-3 rounded-xl transition-colors mt-1 {{ current_route == 'app_user_management' ? 'bg-[#266bfd] text-white shadow-md' : 'text-slate-400 hover:text-white hover:bg-slate-800' }}" 
                title="Gestion Utilisateurs">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
                <span class="hidden lg:inline text-sm font-medium">Gestion Utilisateurs</span>
            </a>
        {% endif %}

        {% if is_granted('Création d\'un rôle') or is_granted('Modification d\'un rôle') or is_granted('Suppression d\'un rôle') %}
            <a href="{{ path('app_role_management') }}" 
                class="flex items-center justify-center lg:justify-start gap-3 px-4 py-3 rounded-xl transition-colors mt-1 {{ current_route == 'app_role_management' ? 'bg-[#266bfd] text-white shadow-md' : 'text-slate-400 hover:text-white hover:bg-slate-800' }}" 
                title="Gestion Rôles">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                <span class="hidden lg:inline text-sm font-medium">Gestion Rôles</span>
            </a>
        {% endif %}

        {% if is_granted('Création d\'un rôle') or is_granted('Suppression d\'un rôle') or is_granted('Attribuer un rôle') or is_granted('Modification d\'un rôle') %}
            <a href="{{ path('app_right_management') }}" 
                class="flex items-center justify-center lg:justify-start gap-3 px-4 py-3 rounded-xl transition-colors mt-1 {{ current_route == 'app_right_management' ? 'bg-[#266bfd] text-white shadow-md' : 'text-slate-400 hover:text-white hover:bg-slate-800' }}" 
                title="Gestion Droits">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                <span class="hidden lg:inline text-sm font-medium">Gestion Droits</span>
            </a>
        {% endif %}

        {% if is_granted('Création de fiche de jeu') or is_granted('Modification d\'une fiche de jeu') or is_granted('Suppression d\'une fiche de jeu') or is_granted('Validation d\'une fiche de jeu') %}
            <a href="{{ path('app_game_management') }}" 
                class="flex items-center justify-center lg:justify-start gap-3 px-4 py-3 rounded-xl transition-colors mt-1 {{ current_route == 'app_game_management' ? 'bg-[#266bfd] text-white shadow-md' : 'text-slate-400 hover:text-white hover:bg-slate-800' }}" 
                title="Gestion Jeux">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                </svg>
                <span class="hidden lg:inline text-sm font-medium">Gestion Jeux</span>
            </a>
        {% endif %}
    </nav>
</aside>