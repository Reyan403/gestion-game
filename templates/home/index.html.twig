{% extends 'base.html.twig' %}

{% block title %}GameVault — Votre univers gaming
{% endblock %}

{% block stylesheets %}
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet">
	{{ parent() }}
{% endblock %}

{% block body %}
	<div
		class="min-h-screen bg-[#0a0a0a] text-[#f1f1f1] font-sans selection:bg-purple-500/35 selection:text-white">

		{# ═══════════════════ HERO ═══════════════════ #}
		<section class="relative min-h-screen flex items-center justify-center overflow-hidden">

			<div class="relative z-10 max-w-3xl px-6 text-center w-full pb-16">
				<h1 class="font-serif text-5xl md:text-6xl font-black leading-[1.1] text-white mb-5">
					Votre univers
					<span class="text-purple-500">gaming</span>
					commence ici
				</h1>
				<p class="text-gray-400 text-base leading-relaxed max-w-[520px] mx-auto mb-10">
					Découvrez des milliers de jeux, partagez vos avis et regardez des lives en direct. Tout au même endroit.
				</p>

				{# Search Bar #}
				<div class="max-w-[520px] mx-auto mb-5 relative group">
					<svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-500 group-focus-within:text-purple-500 transition-colors" fill="none" stroke="currentColor" viewbox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35" stroke-linecap="round" stroke-width="2"/></svg>
					<input type="text" placeholder="Rechercher un jeu, un genre, un live..." class="w-full bg-white/5 border border-white/10 rounded-md py-3.5 pl-11 pr-4 text-sm text-white placeholder-gray-500 outline-none focus:border-purple-500/50 focus:ring-1 focus:ring-purple-500/50 transition-all">
				</div>

				{# Trends #}
				<div class="flex flex-wrap items-center justify-center gap-2 mb-12">
					<span class="text-gray-500 text-xs text-purple-200/50">Tendances :</span>
					{% for tag in ["Call of duty: black ops 6", "Valorant", "Elden Ring", "Cyberpunk 2077", "Grand Theft Auto V", "League of Legends"] %}
						<a href="#" class="text-xs text-gray-400 hover:text-white border border-white/10 hover:border-purple-500/30 hover:bg-purple-500/10 rounded px-2.5 py-1 transition-colors">{{ tag }}</a>
					{% endfor %}
				</div>
			</div>
		</section>

		{# ═══════════════════ JEUX POPULAIRES ═══════════════════ #}
		<section class="py-20 px-6">
			<div class="max-w-7xl mx-auto">
				<div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-10 gap-4">
					<div>
						<p class="text-purple-500 text-[0.65rem] font-bold tracking-[0.2em] uppercase mb-2">Sélection</p>
						<h2 class="font-serif text-3xl sm:text-4xl font-black text-white">Jeux populaires</h2>
					</div>
					<a href="#" class="text-gray-400 hover:text-white text-xs font-bold uppercase tracking-widest transition-colors mb-2">Voir tout →</a>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
					{% set games = [
						{name:"Call of Duty: Black Ops 6", tags:["FPS","Guerre"], desc:"Plongez dans le chaos des opérations secrètes de la guerre froide.", note:4.6, comments:2150, img:"https://www.callofduty.com/content/dam/atvi/callofduty/cod-touchui/store/games/bo6/Store_BO6PDP_Hero.webp"},
						{name:"Valorant", tags:["FPS","Tactique"], desc:"Le jeu de tir tactique à 5 contre 5 basé sur des personnages uniques.", note:4.5, comments:3890, img:"https://img.redbull.com/images/c_crop,w_1920,h_960,x_0,y_103/c_auto,w_1200,h_600/f_auto,q_auto/redbullcom/2020/6/5/ctsejxmdtw9inp8zqqqd/valorant-ameliorer-aim-visee-astuces"},
						{name:"Elden Ring", tags:["RPG","Souls-like"], desc:"Une aventure immense dans l'Entre-terre signée FromSoftware.", note:4.9, comments:4520, img:"https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/1245620/page_bg_raw.jpg?t=1767883716"},
						{name:"Cyberpunk 2077", tags:["RPG","Futuriste"], desc:"Découvrez Night City, une mégalopole obsédée par le pouvoir.", note:4.4, comments:1850, img:"https://www.notebookcheck.biz/fileadmin/Notebooks/News/_nc3/Cyberpunk2077.jpg"},
						{name:"Grand Theft Auto V", tags:["Monde Ouvert","Action"], desc:"Explorez Los Santos et Blaine County dans l'expérience ultime.", note:4.8, comments:5600, img:"https://www.weareplaystation.fr/cdn-cgi/image/w=3840,f=auto,q=80/api/upload/media/post/0001/05/thumb_4497_post_big.png"},
						{name:"League of Legends", tags:["MOBA","Stratégie"], desc:"Affrontez-vous en équipe dans la Faille de l'invocateur.", note:4.3, comments:8900, img:"https://ddragon.leagueoflegends.com/cdn/img/champion/splash/Ahri_0.jpg"}
					] %}

					{% for game in games %}
						<div class="bg-[#111] rounded-lg overflow-hidden border border-white/5 hover:-translate-y-1 hover:shadow-2xl hover:shadow-black/50 hover:border-purple-500/20 transition-all duration-300 group cursor-pointer">
							<div class="relative h-56 overflow-hidden">
								<img src="{{ game.img }}" alt="{{ game.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">
								<div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a]/90 to-transparent opacity-80"></div>
								<div class="absolute bottom-3 left-3 flex gap-1.5">
									{% for tag in game.tags %}
										<span class="bg-black/60 backdrop-blur-sm border border-white/10 text-gray-300 text-[0.6rem] font-bold uppercase tracking-wider px-2 py-1 rounded">{{ tag }}</span>
									{% endfor %}
								</div>
							</div>
							<div class="p-4 sm:p-5">
								<h3 class="font-bold text-white text-[1.05rem] mb-1.5 group-hover:text-purple-400 transition-colors">{{ game.name }}</h3>
								<p class="text-gray-500 text-xs mb-4 line-clamp-2 leading-relaxed">{{ game.desc }}</p>
								<div class="flex items-center justify-between border-t border-white/5 pt-3">
									<div class="flex items-center gap-1.5">
										<span class="text-purple-500 text-sm tracking-tighter">
											{% for i in 1..5 %}
												{{ i <= game.note|round(0,'floor') ? '★' : '☆' }}
											{% endfor %}
										</span>
										<span class="text-xs font-bold text-white">{{ game.note }}</span>
									</div>
									<div class="flex items-center gap-3">
										<div class="flex items-center gap-1 text-gray-500 text-xs font-medium" title="Commentaires">
											<svg class="w-3 h-3" fill="none" stroke="currentColor" viewbox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
											{{ game.comments }}
										</div>
									</div>
								</div>
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>

	</div>
{% endblock %}
